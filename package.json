{
  "name": "mogo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "fronted/apps/*",
    "fronted/core-shared/*",
    "fronted/features/*/*",
    "fronted/apps/mobile/native"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace mogo-fronted",
    "build:web": "npm run build --workspace mogo-fronted",
    "test:shared": "npm test --workspace @mogo/core-shared --workspace @mogo/leetcode-interview-core --workspace @mogo/personal-finance-core --workspace @mogo/user-profile-core",
    "check": "npm run test:shared && npm run build:web",
    "dev:mobile": "npm start --workspace mogo-mobile",
    "android": "npm run android --workspace mogo-mobile",
    "ios": "npm run ios --workspace mogo-mobile",
    "check:mobile": "npm run lint --workspace mogo-mobile && npm run typecheck --workspace mogo-mobile && npm test --workspace mogo-mobile"
  },
  "devDependencies": {
    "react": "18.3.1"
  }
}
