{
  "name": "mogo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "fronted",
    "shared/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace mogo-fronted",
    "build:web": "npm run build --workspace mogo-fronted",
