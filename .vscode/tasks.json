{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MoGo: 配置 C++ 后端",
      "type": "shell",
      "command": "make",
      "args": [
        "backend-configure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": [
              "-l",
              "-c"
            ]
          }
        }
      },
      "problemMatcher": [
        {
          "owner": "clang",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "使用已有 CMake dev preset 生成编译数据库。"
    },
    {
      "label": "MoGo: 构建 C++ 后端",
      "type": "shell",
      "command": "make",
      "args": [
        "backend-build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": [
              "-l",
              "-c"
            ]
          }
        }
      },
      "problemMatcher": [
        {
          "owner": "clang",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "调用现有 Makefile，按项目 C++20 配置构建整个后端。",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "MoGo: 测试 C++ 后端",
      "type": "shell",
      "command": "make",
      "args": [
        "backend-test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": [
              "-l",
              "-c"
            ]
          }
        }
      },
      "problemMatcher": [
        {
          "owner": "clang",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "调用现有 Makefile，构建并运行后端测试。",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
